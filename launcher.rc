#include <winres.h>
#include "src/version.h"

1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LAUNCHER_VERSION_MAJOR,LAUNCHER_VERSION_MINOR,LAUNCHER_VERSION_PATCH,0
PRODUCTVERSION LAUNCHER_VERSION_MAJOR,LAUNCHER_VERSION_MINOR,LAUNCHER_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "X-Men Legends Launcher"
            VALUE "ProductName", "OpenXML1 Launcher"
            VALUE "FileVersion", LAUNCHER_VERSION_TEXT
            VALUE "ProductVersion", LAUNCHER_VERSION_TEXT
            VALUE "OriginalFilename", "X-Men Legends Launcher.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
